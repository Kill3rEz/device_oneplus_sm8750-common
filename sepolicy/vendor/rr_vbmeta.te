type rr_vbmeta, domain;
type rr_vbmeta_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(rr_vbmeta)

allow rr_vbmeta vendor_shell_exec:file rx_file_perms;
allow rr_vbmeta vendor_toolbox_exec:file rx_file_perms;
allow rr_vbmeta toolbox_exec:file rx_file_perms;

# Follow /dev/block/by-name symlinks. The nodes themselves use specific
# types; the generic block_device type cannot be opened.
allow rr_vbmeta block_device:dir r_dir_perms;
allow rr_vbmeta block_device:lnk_file r_file_perms;
allow rr_vbmeta {
    vendor_custom_ab_block_device
    boot_block_device
    recovery_block_device
}:blk_file r_file_perms;

allow rr_vbmeta vendor_data_file:dir create_dir_perms;
allow rr_vbmeta vendor_data_file:file create_file_perms;
type_transition rr_vbmeta vendor_data_file:dir vendor_data_file;
type_transition rr_vbmeta vendor_data_file:file vendor_data_file;

set_prop(rr_vbmeta, rr_vbmeta_prop)
get_prop(rr_vbmeta, bootloader_prop)
# system_server reads the digest when the KeyMint 3 TEE rejects the CSR.
get_prop(system_server, rr_vbmeta_prop)
